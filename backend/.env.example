# AI Drama backend: environment variables. Copy to `.env` (gitignored) and fill in.
# Never commit real values. Never put any of these in a NEXT_PUBLIC_* variable.
#
# The app reads real process environment variables. `.env` is a convenience for
# scripts\run-local.ps1, which loads it into the process environment before starting Maven.

# --- Database (URL and username live in application.yml; only the password is secret) ---
# Required. Password of the PostgreSQL user configured in application.yml (default: postgres).
SPRING_DATASOURCE_PASSWORD=
# Optional overrides:
# SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.100.46:5432/aidrama?options=-c%20timezone=UTC
# SPRING_DATASOURCE_USERNAME=postgres

# --- Auth ---
# Required. HMAC key for signing access, refresh and email-verification tokens.
# At least 32 characters (256 bits). Generate: openssl rand -base64 48
AIDRAMA_JWT_SECRET=

# --- Object storage (S3 compatible: AWS S3, MinIO, ...) ---
# Required: bucket and region. Credentials: leave blank to use the AWS default credential chain.
AIDRAMA_STORAGE_BUCKET=aidrama-media
AIDRAMA_STORAGE_REGION=us-east-1
# Only for non-AWS S3 (MinIO etc.), for example http://localhost:9000
# Public, browser-facing endpoint used to presign upload URLs.
AIDRAMA_STORAGE_ENDPOINT=
# Optional. Direct storage origin for the backend's own signed calls (HEAD, multipart). Set this
# when a caching CDN (e.g. Cloudflare) fronts AIDRAMA_STORAGE_ENDPOINT: the CDN fills its cache for
# a HEAD by fetching the origin with a GET, which breaks a SigV4 HEAD signature and returns 403.
# Point it at the storage origin so backend calls bypass the CDN. Blank = use AIDRAMA_STORAGE_ENDPOINT.
AIDRAMA_STORAGE_INTERNAL_ENDPOINT=
AIDRAMA_STORAGE_PATH_STYLE=false
AIDRAMA_STORAGE_ACCESS_KEY_ID=
AIDRAMA_STORAGE_SECRET_ACCESS_KEY=
# Public (CDN) base URL that serves processed media. The API appends the object key to it.
AIDRAMA_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/aidrama-media

# --- View counting ---
# Optional locally, set it everywhere else. Server-side salt for hashing viewer ids into video_view_events.viewer_key.
# At least 16 characters. Never put it in a NEXT_PUBLIC_* variable. Generate: openssl rand -base64 32
# AIDRAMA_VIEWS_SALT=
# Watch seconds a VIEW_QUALIFIED event needs before it counts as a view (1..3600, default 10).
# AIDRAMA_VIEWS_QUALIFIED_SECONDS=10

# --- Web ---
# Comma-separated browser origins allowed by CORS. Explicit list, no wildcard.
AIDRAMA_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Base URL of the Next.js app. Used to build the email-verification link.
AIDRAMA_WEB_BASE_URL=http://localhost:3000

# --- Dev only toggles (both default to false) ---
# Log the email-verification link instead of only a masked notice. Never enable outside local dev.
AIDRAMA_MAIL_LOG_LINKS=false
# Simulated processing worker. Marks jobs READY without transcoding any media. Local dev only.
AIDRAMA_PROCESSING_DEV_STUB_ENABLED=false
# Dev-stub faststart: run ffmpeg -movflags +faststart on each upload so it plays in the browser.
# Local dev only; requires ffmpeg installed. Leave FFMPEG_PATH as "ffmpeg" if it is on the PATH.
AIDRAMA_PROCESSING_DEV_STUB_FASTSTART_ENABLED=false
AIDRAMA_PROCESSING_DEV_STUB_FASTSTART_FFMPEG_PATH=ffmpeg
