# Base URL of the Spring Boot REST API (see backend/docs/API-CONTRACT.md).
# This is the ONLY variable exposed to the browser (NEXT_PUBLIC_). It is a URL, not a secret.
# It must be an absolute URL: pages call the API during server rendering and the
# /api/auth route handlers forward to it. The API must allow this app's origin via
# AIDRAMA_CORS_ALLOWED_ORIGINS (dev default http://localhost:3000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Optional, server-side build setting (not exposed to the browser): comma-separated
# media hosts that serve API-provided images (thumbnails, avatars), for next/image.
# Each entry may include a scheme and port; a bare hostname defaults to https.
# Examples: MEDIA_IMAGE_HOSTS=cdn.example.com
#           MEDIA_IMAGE_HOSTS=http://192.168.100.50:8333,media.example.com
MEDIA_IMAGE_HOSTS=

# Optional, server-side only (not exposed to the browser): Google image search
# for the upload thumbnail picker. When both are set, a "Google Images" source
# appears alongside Openverse; when unset, only Openverse is offered.
# Google has no free open image API — these come from the Google Custom Search
# JSON API (https://developers.google.com/custom-search/v1/overview):
#   1. Create an API key in Google Cloud and enable "Custom Search API".
#   2. Create a Programmable Search Engine (https://programmablesearchengine.google.com),
#      turn ON "Image search" and "Search the entire web", and copy its Search engine ID.
# Free tier is 100 queries/day; billing is required beyond that.
GOOGLE_IMAGE_SEARCH_KEY=
GOOGLE_IMAGE_SEARCH_CX=
